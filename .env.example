# ==============================================================================
# YAPENDIK SCHOOL OS (TK PILOT) — ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Google Gemini API Key (Optional / AI Capabilities)
GEMINI_API_KEY="your-gemini-api-key-here"

# Application Public Hosting URL
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# SUPABASE PUBLIC FRONTEND CLIENT CREDENTIALS (Anon Key is safe for browser)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# ------------------------------------------------------------------------------
# BACKEND ADMINISTRATIVE SCRIPT CREDENTIALS (NEVER EXPOSE IN FRONTEND OR GIT)
# ------------------------------------------------------------------------------
# Required for scripts/seed_auth.mjs:
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"
PILOT_SEED_DEFAULT_PASSWORD="your-strong-seed-password-here"

# Required for scripts/run_schema.mjs:
DATABASE_URL="postgres://postgres:your-db-password@db.your-project.supabase.co:5432/postgres"
